BACKEND_DOMAIN=fullapi.analist24.it
FRONTEND_DOMAIN=angular.analist24.it
KEYCLOAK_DOMAIN=keycloak.analist24.it

# SSL/Email
SSL_EMAIL=admin@analist24.it

# Database
DB_NAME=prisco_db
DB_USER=postgres
DB_PASS=your-strong-password-here

# Django
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ENVIRONMENT=production

# Keycloak Database
KEYCLOAK_DB_NAME=keycloak_db

# Keycloak Admin
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your-strong-admin-password

# Keycloak Configuration
KEYCLOAK_REALM=web-realm
KEYCLOAK_CLIENT_ID=django-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret-from-keycloak
KEYCLOAK_FRONTEND_CLIENT_ID=angular-frontend

# Keycloak Public Key (get from Keycloak after setup)
KEYCLOAK_PUBLIC_KEY=
